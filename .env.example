# Copy to .env and adjust. `docker compose` reads this file automatically.
# ---------------------------------------------------------------------------

# --- basics ----------------------------------------------------------------
APP_NAME=ChargeFair
COMPANY_NAME=ChargeFair Demo GmbH
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=bitte-aendern-bitte-aendern-32-zeichen
BASE_URL=http://localhost:8000
CHARGEFAIR_PORT=8000
TIMEZONE=Europe/Berlin

# --- registration ----------------------------------------------------------
# A valid registration code is required to create an account.
REGISTRATION_REQUIRES_TOKEN=1
REQUIRE_EMAIL_VERIFICATION=1
# Restrict sign-ups to company addresses, e.g. "firma.de,example.com".
# Empty = no restriction.
ALLOWED_EMAIL_DOMAINS=
PASSWORD_MIN_LENGTH=10
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCK_MINUTES=15
# Set to 1 when serving over HTTPS.
SESSION_COOKIE_SECURE=0

# --- demo data -------------------------------------------------------------
SEED_DEMO=1
SEED_USERS=24
SEED_HISTORY=1
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChargeFair!2026
DEMO_PASSWORD=Demo!2026

# --- allocation ------------------------------------------------------------
# lexicographic | rank_based | guaranteed | lottery | fcfs
ALLOCATION_METHOD=lexicographic
# Guaranteed charging slot per person and week (the promise to employees).
GUARANTEED_SLOTS_PER_WEEK=1
# Upper bound per person and week, including extra wishes from spare capacity.
MAX_SLOTS_PER_WEEK=3
SOLVER_TIME_LIMIT=20
SOLVER_WORKERS=8
BOOKING_HORIZON_WEEKS=10

# --- allocation phases -----------------------------------------------------
# Length of an allocation phase in weeks (4 is the recommended default).
PHASE_WEEKS=4
# Days before the deadline at which the reminder mail goes out (0 = off).
PHASE_REMINDER_DAYS=2
# Minutes before a charging slot that the reminder mail goes out.
SLOT_REMINDER_MINUTES=45

# --- email -----------------------------------------------------------------
# 1 = write messages to data/mail_outbox instead of sending them.
MAIL_DRY_RUN=1
MAIL_FROM=chargefair@example.com
MAIL_FROM_NAME=ChargeFair
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# 1 = STARTTLS (port 587), 0 = implicit TLS (port 465)
SMTP_TLS=1
MAIL_WORKER_INTERVAL=15
# Messages per worker run - one SMTP connection is used for the whole batch.
MAIL_BATCH_SIZE=50
SMTP_TIMEOUT=30

# --- server ----------------------------------------------------------------
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
